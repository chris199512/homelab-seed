# homelab-seed configuration
#
# Copy this file to config.env and adjust it. config.env is git-ignored – never commit it.
# The file is read by bash: write KEY="value" and use single quotes for values that
# contain $ or backticks. File paths are relative to this file and must point
# inside its directory (subdirectories are fine).
# Switches accept true/false.
#
# Keep every value in one place: a setting can reuse an earlier one, e.g.
#   BOOTSTRAP_BECOME_PASSWORD="$ADMIN_PASSWORD"

############################################################################
# Base image
############################################################################

# Raspberry Pi OS Lite (64-bit). For reproducible builds pin a specific release from
# https://downloads.raspberrypi.org/raspios_lite_arm64/images/
RASPIOS_IMAGE_URL="https://downloads.raspberrypi.org/raspios_lite_arm64_latest"
# SHA256 of the .img.xz download. If empty, the checksum published next to the
# image is used.
RASPIOS_IMAGE_SHA256=""

############################################################################
# System
############################################################################

TARGET_HOSTNAME="seed"
TIMEZONE="Europe/Berlin"
LOCALE="en_US.UTF-8"
KEYBOARD_LAYOUT="us"

# Admin account on both the installer stick and the installed system.
# The password is used for console login and sudo; SSH only accepts keys.
ADMIN_USER="admin"
ADMIN_PASSWORD=""
# One or more SSH public keys in authorized_keys format (required).
ADMIN_AUTHORIZED_KEYS_FILE="./secrets/authorized_keys"

############################################################################
# Network (applies to the installer and the installed system)
############################################################################

# "ethernet" or "wifi"
NETWORK_INTERFACE="ethernet"
# "dhcp" or "static"
NETWORK_IPV4="dhcp"
# Static only: address with prefix length and the gateway.
NETWORK_ADDRESS=""                 # e.g. 192.168.1.10/24
NETWORK_GATEWAY=""                 # e.g. 192.168.1.1
# DNS servers, separated by spaces. Required for static, optional for DHCP
# (overrides the DNS servers from DHCP).
NETWORK_DNS=""                     # e.g. "192.168.1.1 9.9.9.9"

# Wi-Fi only
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_COUNTRY="DE"                  # ISO 3166 country code, required for Wi-Fi

# NTP servers, separated by spaces. Empty = Raspberry Pi OS defaults.
NTP_SERVERS=""

############################################################################
# Installer (USB stick)
############################################################################

# Disk the system is written to. EVERYTHING ON IT IS ERASED.
TARGET_DEVICE="/dev/mmcblk0"
# Target already contains a homelab-seed system: "skip" or "overwrite".
INSTALLER_IF_INSTALLED="skip"
# After a successful installation: "reboot" or "poweroff".
INSTALLER_AFTER_INSTALL="reboot"

############################################################################
# First-boot setup
############################################################################

# Upgrade all packages during the setup.
SETUP_SYSTEM_UPGRADE="true"
# Reboot once the setup is complete.
SETUP_REBOOT_WHEN_DONE="true"
# Additional apt packages, separated by spaces.
EXTRA_PACKAGES=""
# Directory with your own *.sh scripts. They run as root at the end of the
# setup in alphabetical order; each one runs once. All settings of this file
# are available as environment variables.
HOOKS_DIR=""

############################################################################
# Security and maintenance
############################################################################

# Install security updates automatically (unattended-upgrades).
UNATTENDED_UPGRADES="true"
# Reboot automatically when an update requires it, at the given time.
UNATTENDED_UPGRADES_REBOOT="false"
UNATTENDED_UPGRADES_REBOOT_TIME="04:00"

# Firewall (ufw): deny incoming traffic except SSH, the configured service
# ports and FIREWALL_ALLOW. Note: ports published by Docker containers bypass
# ufw – containers you add later are reachable regardless of these rules.
FIREWALL_ENABLED="false"
# Networks allowed to connect via SSH: "any" or CIDRs separated by spaces.
FIREWALL_SSH_FROM="any"
# Additional rules, separated by spaces, e.g. "8080/tcp 53/udp".
FIREWALL_ALLOW=""

############################################################################
# Docker
############################################################################

# Required for Semaphore and the proxy.
DOCKER_ENABLED="true"
# User-defined network shared by all containers (Semaphore, nginx and anything
# you add later).
DOCKER_NETWORK="homelab"

############################################################################
# Semaphore UI (Ansible)
############################################################################

SEMAPHORE_ENABLED="true"
SEMAPHORE_VERSION="v2.17.26"
# Host port. With the proxy enabled Semaphore only listens on localhost.
SEMAPHORE_PORT="3000"
SEMAPHORE_ADMIN_USER="admin"
SEMAPHORE_ADMIN_NAME="Admin"
SEMAPHORE_ADMIN_EMAIL="admin@example.com"
SEMAPHORE_ADMIN_PASSWORD=""
SEMAPHORE_TOTP_ENABLED="false"
# Public URL of Semaphore. Derived from the proxy settings if empty.
SEMAPHORE_WEB_HOST=""

# E-mail alerts. Leave SMTP_HOST empty to disable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER=""
SMTP_SECURE="true"

############################################################################
# Reverse proxy (nginx)
############################################################################

# nginx in front of Semaphore. Other services can add their own server blocks
# to /etc/nginx/conf.d later.
PROXY_ENABLED="false"
NGINX_VERSION="1.30.0"
PROXY_HTTP_PORT="80"
PROXY_HTTPS_PORT="443"
# Domain name Semaphore is served under. Required for Let's Encrypt;
# otherwise optional (empty = any name).
SEMAPHORE_FQDN=""

############################################################################
# TLS certificate (requires the proxy)
############################################################################

# none              plain HTTP
# selfsigned        self-signed certificate, browsers show a warning
# letsencrypt-http  Let's Encrypt via HTTP-01: port 80 must be reachable from
#                   the internet under SEMAPHORE_FQDN
# letsencrypt-dns   Let's Encrypt via DNS-01: works for internal hosts, needs
#                   API access to your DNS provider
TLS_MODE="none"

# Let's Encrypt
ACME_EMAIL=""
# Use the staging CA while testing (certificates are not trusted).
ACME_STAGING="false"

# DNS-01 provider. Any certbot DNS plugin works – its Debian package
# python3-certbot-dns-<provider> is installed automatically:
#   cloudflare, digitalocean, dnsimple, linode, ovh, rfc2136, google, gehirn,
#   luadns, nsone, sakuracloud, dnsmadeeasy
# Built in: mittwald (needs a DNS zone "_acme-challenge.<SEMAPHORE_FQDN>" in mStudio).
ACME_DNS_PROVIDER="cloudflare"
# For providers that need only an API token (cloudflare, digitalocean,
# dnsimple, linode, mittwald). Cloudflare: permission Zone:DNS:Edit.
ACME_DNS_API_TOKEN=""
# For all other providers: credentials file in the format of the certbot
# plugin, e.g. for ovh: dns_ovh_endpoint, dns_ovh_application_key, …
# See https://eff-certbot.readthedocs.io/en/stable/using.html#dns-plugins
ACME_DNS_CREDENTIALS_FILE=""
# Seconds to wait for the DNS record to propagate.
ACME_DNS_PROPAGATION_SECONDS="60"

############################################################################
# Semaphore bootstrap (optional)
############################################################################

# Creates a Semaphore project wired to your Ansible repository and runs a
# bootstrap playbook from it. Names are configurable so your playbooks can look
# the resources up.
BOOTSTRAP_ENABLED="false"
BOOTSTRAP_PROJECT_NAME="Homelab"

# Git repository with your playbooks.
BOOTSTRAP_REPO_NAME="Homelab"
BOOTSTRAP_REPO_URL="https://github.com/you/homelab.git"
BOOTSTRAP_REPO_BRANCH="main"
# Credentials for private HTTPS repositories (e.g. a GitHub fine-grained token).
# Leave BOOTSTRAP_REPO_TOKEN empty for public repositories.
BOOTSTRAP_REPO_KEY_NAME="Git Token"
BOOTSTRAP_REPO_USER="git"
BOOTSTRAP_REPO_TOKEN=""

# SSH key Ansible uses to connect to your hosts.
BOOTSTRAP_SSH_KEY_NAME="SSH"
BOOTSTRAP_SSH_LOGIN="admin"
BOOTSTRAP_SSH_PRIVATE_KEY_FILE=""
BOOTSTRAP_SSH_PASSPHRASE=""

# sudo password for the hosts (Ansible "become"). Optional.
BOOTSTRAP_BECOME_KEY_NAME="Become"
BOOTSTRAP_BECOME_PASSWORD=""

# Inventory file inside the repository.
BOOTSTRAP_INVENTORY_NAME="Default"
BOOTSTRAP_INVENTORY_PATH="inventory.yaml"

# File with KEY=VALUE lines that become secret environment variables in
# Semaphore (values are taken literally, no quotes needed). SEMAPHORE_TOKEN,
# an API token of the admin user, is always added.
# ${NAME} inserts the value of a setting from this file, ${ADMIN_SSH_KEYS} all
# keys of ADMIN_AUTHORIZED_KEYS_FILE separated by ";" – e.g.
#   MITTWALD_TOKEN=${ACME_DNS_API_TOKEN}
#   LINUX_ROOT_PASSWORD=${ADMIN_PASSWORD}
BOOTSTRAP_ENVIRONMENT_NAME="Secrets"
BOOTSTRAP_SECRETS_FILE=""

# Playbook (path inside the repository) that is registered as a template and
# run once. Leave empty to only create the project.
BOOTSTRAP_TEMPLATE_NAME="Bootstrap"
BOOTSTRAP_PLAYBOOK=""
# Comma-separated template names to run afterwards, in this order. They may be
# templates created by the bootstrap playbook.
BOOTSTRAP_RUN_AFTER=""
# Maximum time in seconds to wait for each of these tasks.
BOOTSTRAP_TASK_TIMEOUT="1800"
